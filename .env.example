# Copy to .env and adjust. Nothing here is a secret by default; keep real keys out of git.

# --- LLM (Ollama, OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4-voice   # created from ollama/Modelfile.voice
LLM_API_KEY=ollama
LLM_NUM_CTX=6144

# --- Speech ---
LANGUAGE=en
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
TTS_ENGINE=kokoro
TTS_VOICE=af_heart
STT_PROMPT=

# --- Knowledge ---
KNOWLEDGE_DIR=./knowledge
INDEX_DIR=./data/index
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# --- CRM ---
# mock = in-memory (tests, first demos).  http = the ascend-travel-crm agent API.
CRM_BACKEND=mock
CRM_BASE_URL=http://localhost:3300/api/agent/v1
CRM_API_KEY=
# WebRTC tests have no caller ID; this simulates the caller's number (E.164).
DEV_CALLER_PHONE=
# An open enquiry for the same destination updated within this many days is offered for update, not duplicated.
DUPLICATE_WINDOW_DAYS=30

# --- Phone calls via Plivo (placeholders; same Auth ID/Token as the CRM's .env) ---
# Run:  uv run python -m agent.bot -t plivo --proxy voice.example.com   (the public host Plivo reaches, wss://<host>/ws)
# Plivo's answer webhook is the CRM's /api/webhooks/plivo/answer, which streams the call to that wss URL.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# --- Hosted LLM fallback: off by default, LLM-only, PII masked ---
FALLBACK_LLM_ENABLED=false
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=
