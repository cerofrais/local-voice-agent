{
  "_note": "Matchers: equals, contains_any (list), digits (digit string after stripping non-digits). A 'tool' case passes when every expected call is present with matching args and no call to an unexpected tool is made. A 'text' case checks the reply; tool calls are allowed only if allow_tools is true.",
  "system": "You are Asha, a voice assistant for a travel company. You speak on a phone call, so reply in one or two short sentences with no lists, no markdown and no emojis. Your jobs: work out which trip the caller means, collect the lead details one at a time, and answer basic questions. Answer only from search_knowledge results; if the answer is not there, say you do not have it and offer a callback or a human colleague. Never invent prices, dates or policies. Use tools instead of guessing. Ask for only one missing detail at a time. Tool rules: call set_lead_field as soon as the caller gives any lead detail, one call per detail. Call identify_trip when the caller mentions a trip, a destination or a kind of trip. Call search_knowledge before answering any factual question about trips, prices, inclusions or policies. Call schedule_callback when the caller asks to be called back at some time. Call handoff_to_human as soon as the caller asks for a person, without asking why. After a tool result, always say a short spoken reply.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "identify_trip",
        "description": "Find which trip the caller is talking about from their own words. Returns up to three candidates with scores.",
        "parameters": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            }
          },
          "required": [
            "description"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_knowledge",
        "description": "Search the trip brochures and FAQs for facts to answer a caller's question.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "set_lead_field",
        "description": "Save one lead detail the caller has given.",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "name",
                "phone",
                "email",
                "trip",
                "travel_dates",
                "group_size",
                "budget",
                "departure_city",
                "notes"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "value"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_missing_fields",
        "description": "List the required lead details that are still missing.",
        "parameters": {
          "type": "object",
          "properties": {}
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "schedule_callback",
        "description": "Book a callback from a human consultant.",
        "parameters": {
          "type": "object",
          "properties": {
            "when": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "when"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "handoff_to_human",
        "description": "Transfer the call to a human agent.",
        "parameters": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ]
        }
      }
    }
  ],
  "cases": [
    {
