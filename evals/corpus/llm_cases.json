          "role": "user",
          "content": "My name is Venkata Subramaniam."
        }
      ],
      "expect": {
        "kind": "tool",
        "calls": [
          {
            "name": "set_lead_field",
            "args": {
              "name": {
                "equals": "name"
              },
              "value": {
                "contains_any": [
                  "venkata subramaniam"
                ]
              }
            }
          }
        ]
      }
    },
